#!/bin/bash
set -Eeuo pipefail

trap 'status=$?; echo "INSTALL_FAILED status=${status}" >&2; return "${status}" 2>/dev/null || exit "${status}"' ERR

VENV_DIR="/opt/mini-swe-agent-venv"
RUNTIME_MARKER="/opt/testprism-mini-swe-agent-runtime.json"
MINI_BIN=""
SYSTEM_PYTHON="/usr/bin/python3"
EXPECTED_MINI_SWE_VERSION="${TESTPRISM_MINI_SWE_VERSION_SPEC:-2.4.6}"
EXPECTED_MINI_SWE_RUNTIME_KEY="${TESTPRISM_MINI_SWE_RUNTIME_KEY:-}"

if [ ! -x "${SYSTEM_PYTHON}" ]; then
  SYSTEM_PYTHON="$(command -v python3)"
fi

if [ -x "${VENV_DIR}/bin/python" ] && [ -x "${VENV_DIR}/bin/mini" ] && [ -f "${RUNTIME_MARKER}" ]; then
  if EXPECTED_MINI_SWE_VERSION="${EXPECTED_MINI_SWE_VERSION}" \
     EXPECTED_MINI_SWE_RUNTIME_KEY="${EXPECTED_MINI_SWE_RUNTIME_KEY}" \
     "${VENV_DIR}/bin/python" - <<'PY'
import json
import os
from pathlib import Path

marker = Path("/opt/testprism-mini-swe-agent-runtime.json")
data = json.loads(marker.read_text())
assert data.get("version_spec", "") == os.environ["EXPECTED_MINI_SWE_VERSION"]
runtime_key = os.environ.get("EXPECTED_MINI_SWE_RUNTIME_KEY", "")
if runtime_key:
    assert data.get("runtime_key", "") == runtime_key
PY
  then
    MINI_BIN="${VENV_DIR}/bin/mini"
    echo "Using preinstalled mini-swe-agent runtime from ${VENV_DIR}"
  fi
fi

if [ -z "${MINI_BIN}" ]; then
  if [ -x "${VENV_DIR}/bin/mini" ] || [ -f "${RUNTIME_MARKER}" ]; then
    rm -rf "${VENV_DIR}" "${RUNTIME_MARKER}"
  fi

  apt-get update
  apt-get install -y python3 python3-pip python3-venv

  "${SYSTEM_PYTHON}" - <<'PY'
import sys

if sys.version_info < (3, 10):
    print(
        "mini-swe-agent requires Python >=3.10",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY

  "${SYSTEM_PYTHON}" -m venv "${VENV_DIR}"
  "${VENV_DIR}/bin/pip" install --upgrade pip

{% if version %}
  "${VENV_DIR}/bin/pip" install "mini-swe-agent=={{ version }}"
{% else %}
  "${VENV_DIR}/bin/pip" install "mini-swe-agent==2.4.6"
{% endif %}
  MINI_BIN="${VENV_DIR}/bin/mini"
else
  "${MINI_BIN}" --help >/dev/null
fi

# Fail fast if installation completed but CLI isn't available.
"${MINI_BIN}" --help >/dev/null

cat > /installed-agent/run-mini-swe-agent.sh <<SH
#!/bin/bash
set -euo pipefail

MINI_BIN="${MINI_BIN}"
PYTHON_BIN="${VENV_DIR}/bin/python"
LOG_DIR="\${TESTPRISM_AGENT_LOG_DIR:-/agent-logs}"
INSTRUCTION_PATH="\${TESTPRISM_TASK_INSTRUCTION_PATH:-/installed-agent/task-instruction.txt}"
MODEL="\${TESTPRISM_MINI_SWE_MODEL:?TESTPRISM_MINI_SWE_MODEL is required}"
SYSTEM_PROMPT_PATH="\${TESTPRISM_SYSTEM_PROMPT_PATH:-}"
SYSTEM_PROMPT_CONFIG="/installed-agent/mini-swe-system-prompt.yaml"
BASE_CONFIG="\${TESTPRISM_MINI_SWE_BASE_CONFIG:-}"

mkdir -p "\${LOG_DIR}"
CONFIG_ARGS=()
if [ -n "\${BASE_CONFIG}" ]; then
  CONFIG_ARGS=(-c "\${BASE_CONFIG}")
fi
if [ -n "\${SYSTEM_PROMPT_PATH}" ]; then
  "\${PYTHON_BIN}" - "\${SYSTEM_PROMPT_PATH}" "\${SYSTEM_PROMPT_CONFIG}" <<'PY'
import sys
from pathlib import Path

import yaml

prompt = Path(sys.argv[1]).read_text(encoding="utf-8").strip()
Path(sys.argv[2]).write_text(
    yaml.safe_dump(
        dict(agent=dict(system_template=prompt)),
        allow_unicode=True,
        sort_keys=False,
    ),
    encoding="utf-8",
)
PY
  if [ -z "\${BASE_CONFIG}" ]; then
    CONFIG_ARGS=(-c mini.yaml)
  fi
  CONFIG_ARGS+=(-c "\${SYSTEM_PROMPT_CONFIG}")
fi
"\${MINI_BIN}" \
  "\${CONFIG_ARGS[@]}" \
  -m "\${MODEL}" \
  -t "\$(cat "\${INSTRUCTION_PATH}")" \
  -y --exit-immediately \
  -o "\${LOG_DIR}/mini-swe-trajectory.json" \
  2>&1 | tee "\${LOG_DIR}/mini-swe-agent.log"
SH
chmod +x /installed-agent/run-mini-swe-agent.sh

echo "INSTALL_SUCCESS"
