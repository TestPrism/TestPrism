#!/bin/bash

# The Docker runtime layer puts Claude Code in /usr/local/bin.  Prefer it so
# task containers do not need access to apt, GitHub, Node, or npm at startup.
if command -v claude >/dev/null 2>&1; then
  claude --version
  # This script is sourced by AbstractInstalledAgent. Returning preserves the
  # tmux shell so its trailing completion signal can run.
  return 0
fi

set -e

apt-get update
apt-get install -y curl

curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash

source "$HOME/.nvm/nvm.sh"

nvm install 22
npm -v

npm install -g @anthropic-ai/claude-code@{{ version }}
