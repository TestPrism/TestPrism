# Azure OpenAI (CloudGPT) Configuration
# Token is auto-refreshed by scripts/run_eval.sh via Azure CLI
AZURE_API_BASE=https://cloudgpt-openai.azure-api.net
AZURE_API_VERSION=2025-04-01-preview
DEFAULT_MODEL=azure/gpt-4o-20241120

# LLM Provider API Keys (set the one you're using)
# ANTHROPIC_AUTH_TOKEN=   # used by claude-code agent
# ANTHROPIC_API_KEY=      # used by aider / goose / other agents
# OPENAI_API_KEY=

# AWS Credentials (for S3 result upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Database Credentials (optional)
DB_HOST=your-db-endpoint.rds.amazonaws.com
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=

# Supabase Credentials (optional)
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key