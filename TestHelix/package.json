{
  "name": "testhelix",
  "version": "0.2.0",
  "description": "Execution-guided test generation for TestPrism, powered by Pi and the Vercel AI SDK.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "testhelix": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=3 tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "start": "tsx src/cli.ts",
    "bench:inventory": "tsx src/cli.ts inventory --bench TestPrism-main",
    "smoke:docker": "tsx scripts/smoke-docker.ts",
    "smoke:evolve": "tsx scripts/smoke-evolve.ts",
    "bench:efficiency": "tsx scripts/benchmark-efficiency.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/openai": "4.0.60",
    "@ai-sdk/openai-compatible": "3.0.44",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@openai/agents-core": "0.17.2",
    "ai": "7.0.93",
    "diff": "9.0.0",
    "js-tiktoken": "1.0.21",
    "jsonc-parser": "3.3.1",
    "p-limit": "7.3.2",
    "picomatch": "4.0.7",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.8.0",
    "undici": "7.29.1",
    "yaml": "^2.8.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "4.0.3",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
